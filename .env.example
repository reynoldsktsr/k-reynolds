# Sanity project (create one at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Optional: only needed for authenticated writes/previews from the app itself.
# Studio editing (at /studio) works without this once you're logged in via the browser.
SANITY_API_READ_TOKEN=

# Canonical site URL, used for metadata, sitemap, and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
